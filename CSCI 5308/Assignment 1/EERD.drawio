        <mxCell id="lbl1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;Complete (total)&lt;/b&gt;: double line&lt;br&gt;&lt;b&gt;Defining attribute&lt;/b&gt;: SpaceType" vertex="1">
