        </mxCell>
        <mxCell id="lbl2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;Disjoint&lt;/b&gt; (d)" vertex="1">
          <mxGeometry height="22" width="120" x="752" y="490" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style=&quot;font-size:18px&quot;&gt;EERD: &lt;/b&gt;&lt;span style=&quot;font-size:18px&quot;&gt;SPACE speci&lt;/span&gt;&lt;span style=&quot;font-size:18px&quot;&gt;alization&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="420" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;Reading the diagram&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;d&lt;/b&gt; = disjoint: a space is exactly one of COURT, TRACK or ROOM, never two at once (an overlapping design would use &lt;b&gt;o&lt;/b&gt;).&lt;br&gt;&amp;bull; &lt;b&gt;Double line&lt;/b&gt; from SPACE to the circle = complete (total) specialization: every SPACE must be a COURT, TRACK or ROOM; there is no &quot;other&quot; space.&lt;br&gt;&amp;bull; &lt;b&gt;&amp;cup;&lt;/b&gt; on each line = subset symbol (the subtype is a subset of SPACE). Subtypes inherit SpaceID, SpaceNo, UsageMode, IsRentable, SpaceType and the relationships to FACILITY and SCHEDULE_SLOT.&lt;br&gt;&amp;bull; Underlined = key. Red outline = attribute that defines the subtype (SpaceType = COURT / TRACK / ROOM). Grey dashed boxes are context only. Double lines to FACILITY mean total participation.&lt;br&gt;&amp;bull; Rock Court is a COURT (CourtType = Rock); Address and Contact apply to it and to TRACK only, so they are optional on COURT. Pools and studios are ROOMs (RoomType)." vertex="1">
          <mxGeometry height="150" width="1300" x="40" y="880" as="geometry" />
        </mxCell>
        <mxCell id="SBUjzU-0Wfxb9HEv7D-L-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;SpaceType&lt;/b&gt;: this attribute is the subtype discriminator&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="230" x="850" y="160" as="geometry" />
        </mxCell>
        <mxCell id="SBUjzU-0Wfxb9HEv7D-L-4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" value="&lt;span style=&quot;text-decoration: underline;&quot;&gt;RoomID&lt;/span&gt;" vertex="1">
